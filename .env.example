# Configure values in Render Environment. Never commit actual credentials.
# Exactly two pre-created, email-confirmed Supabase Auth user UUIDs.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
PRIVATE_USER_IDS=
# Translation remains independent of WebRTC audio/video.
OPENAI_API_KEY=
# Optional: comma-separated URLs or JSON URL arrays. Configure a dedicated TURN
# provider before claiming cross-network reliability. Do not put credentials here.
STUN_URLS=
TURN_URLS=
TURN_USERNAME=
TURN_PASSWORD=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
