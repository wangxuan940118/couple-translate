# Required private chat: Supabase PostgreSQL + Auth. Run supabase/private-chat.sql first.
# Enter real values only in your server's environment settings; do not commit them.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Exactly TWO confirmed Supabase Auth user UUIDs, separated by one comma.
PRIVATE_USER_IDS=

# Translation stays on the server. API billing is separate from ChatGPT membership.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional TURN relay. Obtain credentials from your own provider; never commit them.
# Either JSON array or comma-separated STUN/TURN URLs.
# TURN bandwidth can incur charges; STUN-only cannot guarantee NAT traversal.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478
TURN_URLS=
TURN_USERNAME=
TURN_PASSWORD=

# Optional push notifications; subscriptions are currently memory-only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Render provides RENDER_GIT_COMMIT. Other deployments can set BUILD_SHA.
BUILD_SHA=
# Only trust X-Forwarded-For behind a proxy that overwrites it. Render is detected.
TRUST_PROXY=0
PORT=3000

# No ROOM_DATA_PATH: files or memory are not a fallback for durable private chat.
