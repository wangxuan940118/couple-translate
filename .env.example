# Translation stays on the server. API usage is billed to this project's API account.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional TURN relay. Obtain credentials from your own provider; never commit them.
# Either JSON array or comma-separated TURN URLs, supporting UDP/TCP/TLS as provided.
# TURN traffic may incur provider bandwidth charges; STUN-only cannot guarantee NAT traversal.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478
TURN_URLS=
TURN_USERNAME=
TURN_PASSWORD=

# Optional push notifications. Subscriptions are memory-only in this test version.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Render provides RENDER_GIT_COMMIT automatically. Other deployments can set BUILD_SHA.
BUILD_SHA=
# Set only behind a reverse proxy that overwrites X-Forwarded-For. Render is detected automatically.
TRUST_PROXY=0
PORT=3000
